# ================================================
# SIJARAK - Konfigurasi Environment Variables
# ================================================
# Salin file ini menjadi .env untuk development lokal
# Untuk Railway: set variabel ini di Dashboard → Variables

# === DATABASE ===
# Pilih salah satu:
# - MONGO_URI : untuk MongoDB Atlas / custom URI
# - MONGO_URL : otomatis tersedia jika pakai Railway MongoDB Plugin
MONGO_URI=mongodb://localhost:27017/sijarak

# === JWT SECRET ===
# Ganti dengan string random yang panjang dan kuat!
JWT_SECRET=sijarak-jwt-secret-ganti-ini-sekarang

# === PORT ===
# Railway akan set PORT otomatis, tidak perlu diubah
# PORT=3000
